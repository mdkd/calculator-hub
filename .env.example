# Copy this file to .env.local and fill in real values when ready to go live.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Google AdSense publisher/client ID, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT_ID=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Set to "true" to render real AdSense ad units instead of placeholder boxes.
# Leave "false" (or unset) until the site is reviewed and approved for ads.
VITE_ADS_ENABLED=false
